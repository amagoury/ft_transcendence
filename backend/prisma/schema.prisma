// This is your Prisma schema file — extend it as you build out
// playlists, tracks, friends, chat, etc. (see the module plan in the README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())
}
